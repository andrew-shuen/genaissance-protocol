{
  "reviewed": "2026-06",
  "groups": [
    {
      "key": "learn",
      "label": {
        "en": "Learn the basics",
        "fr": "Notions de base"
      },
      "blurb": {
        "en": "Plain-language primers on the concepts behind the protocols: how genes and inheritance work, how cancer risk can be inherited, repeat expansions, testing relatives, and how your genetic information is protected.",
        "fr": "Des introductions en langage clair aux notions derrière les protocoles : le fonctionnement des gènes et de l'hérédité, la transmission du risque de cancer, les expansions de répétitions, le test des proches, et la protection de votre information génétique."
      }
    },
    {
      "key": "tests",
      "label": {
        "en": "Types of tests",
        "fr": "Types de tests"
      },
      "blurb": {
        "en": "A plain-language guide to the laboratory tests you may be offered, from focused gene panels to whole exome sequencing, and the chromosome and prenatal tests, so you know what each one looks at.",
        "fr": "Un guide en langage clair des analyses de laboratoire qui peuvent vous être proposées, des panels de gènes ciblés au séquençage de l'exome entier, ainsi que des tests chromosomiques et prénataux, pour que vous sachiez ce que chacun examine."
      }
    },
    {
      "key": "derm",
      "label": {
        "en": "Skin biopsy in genetics",
        "fr": "Biopsie cutanée en génétique"
      },
      "blurb": {
        "en": "A small skin sample can be a window into the genome. It supplies living cells for culture, biochemical study, and DNA analysis, and can reveal variants confined to certain tissues that a blood test would miss.",
        "fr": "Un petit échantillon de peau peut être une fenêtre sur le génome. Il fournit des cellules vivantes pour la culture, l'étude biochimique et l'analyse de l'ADN, et peut révéler des variants limités à certains tissus qu'une prise de sang ne détecterait pas."
      }
    },
    {
      "key": "connective",
      "label": {
        "en": "Connective tissue",
        "fr": "Tissu conjonctif"
      }
    },
    {
      "key": "cancer",
      "label": {
        "en": "Hereditary cancer",
        "fr": "Cancers héréditaires"
      }
    },
    {
      "key": "adult",
      "label": {
        "en": "Adult conditions",
        "fr": "Conditions de l'adulte"
      }
    },
    {
      "key": "cardiac",
      "label": {
        "en": "Cardiac genetics",
        "fr": "Génétique cardiaque"
      },
      "blurb": {
        "en": "Inherited heart-rhythm and heart-muscle conditions where a genetic diagnosis guides surveillance, treatment, and testing of relatives.",
        "fr": "Affections héréditaires du rythme et du muscle cardiaques où un diagnostic génétique oriente la surveillance, le traitement et le test des proches."
      }
    },
    {
      "key": "prenatal",
      "label": {
        "en": "Prenatal / preconception",
        "fr": "Prénatal / préconception"
      },
      "blurb": {
        "en": "Findings and screening before or during pregnancy, including carrier screening and the work-up prompted by fetal imaging or prenatal testing.",
        "fr": "Constatations et dépistage avant ou pendant la grossesse, y compris le dépistage des porteurs et le bilan motivé par l'imagerie fœtale ou les tests prénataux."
      }
    },
    {
      "key": "pediatric",
      "label": {
        "en": "Pediatric conditions",
        "fr": "Conditions pédiatriques"
      },
      "blurb": {
        "en": "Conditions presenting in infancy or childhood that warrant genetics assessment and tailored surveillance.",
        "fr": "Conditions se manifestant durant la petite enfance ou l'enfance qui justifient une évaluation génétique et une surveillance adaptée."
      }
    }
  ],
